# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# Your local PostgreSQL database.
# If your password contains @ : / ? # [ ] or a space, percent-encode it:
#   @ -> %40   : -> %3A   / -> %2F   ? -> %3F   # -> %23   space -> %20
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/youthlink?schema=public"

# Port the Express API listens on
PORT=3000

# Deterministic NIC encryption (FR-ACC-04, FR-ACC-05, NFR-SEC-03).
# Both are 32-byte keys, hex-encoded as 64 hex characters. Generate distinct
# values for each — never reuse one key for both:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NIC_ENCRYPTION_KEY=replace_with_64_hex_characters
NIC_IV_KEY=replace_with_64_hex_characters

# Firebase Admin service-account credentials (FR-ACC-08).
# Download from Firebase Console -> Project Settings -> Service Accounts ->
# Generate New Private Key. Save the downloaded file in backend/ under its
# default Firebase-generated name (it contains "firebase-adminsdk", already
# covered by .gitignore — no renaming needed), then point this at it.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-adminsdk.json

# JWT signing secret (FR-ACC-07). Stateless JWT, no session/refresh-token
# table (see docs/database-schema.md's Design Decisions) — this is the only
# thing standing between a token and forgery, so keep it long and random.
# Generate a 64-byte value, hex-encoded:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_hex_value
