  // WARNING_RECORDED tells a party a warning was recorded against them (FR-NOTIF-12),
  // and its history rows are kept 90 days rather than 30 (FR-NOTIF-08);
  // ENDORSEMENT_REVOKED tells a worker an endorsement was revoked (FR-ENDORSE-07).
  APPLICATION_TERMS_CHANGED
  WARNING_RECORDED
  ENDORSEMENT_REVOKED
}
