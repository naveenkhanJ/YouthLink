// YouthLink — database schema
//
// Implements docs/database-schema.md. Every field traces to a requirement in
// docs/requirements.md; see the design document for the reasoning behind each
// table, and for what is deliberately NOT modelled.
//
// Note: four PARTIAL unique indexes cannot be expressed in Prisma schema syntax and
// live as raw SQL in migrations: User.phone, User.email and User.nicEncrypted in the
// initial migration, and Endorsement(endorserId, workerId) where revokedAt is null in
// 20260925001500_prototype_spec_batch. Do not "fix" them by adding @unique or
// @@unique here — that would be wrong.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// 1. Identity & Access
// ---------------------------------------------------------------------------

model User {
  id                           String         @id @default(uuid())
  role                         ActorRole
  phone                        String
  phoneVerifiedAt              DateTime?
  passwordHash                 String
  // Batch A5 (2026-08-27). Any JWT whose `iat` predates this is rejected by requireAuth, so a
  // password reset or change signs out every device (FR-ACC-07, NFR-SEC-06).
  passwordChangedAt            DateTime?
  failedLoginAttempts          Int            @default(0)
  lockedUntil                  DateTime?
  email                        String?
  emailVerifiedAt              DateTime?
  nicEncrypted                 String
  nicLast4                     String         @db.VarChar(4)
  legalName                    String         @db.VarChar(100)
  birthdate                    DateTime       @db.Date
  postingAsType                PostingAsType?
  businessName                 String?        @db.VarChar(100)
  businessBio                  String?        @db.VarChar(300)
  bio                          String?        @db.VarChar(300)
  bioPromptShownAt             DateTime?
  endorsementSuggestionShownAt DateTime?
  notifyUrgentOptIn            Boolean        @default(false)
  notifyNewGigOptOut           Boolean        @default(false)
  tosAcceptedAt                DateTime?
  accountStatus                AccountStatus  @default(PENDING_SIGNUP)
  signupExpiresAt              DateTime?
  endorsementCode              String?        @unique @db.VarChar(6)
  firstRatingReceivedAt        DateTime?
  autoHiddenAt                 DateTime?
  suspendedAt                  DateTime?
  suspensionReason             String?
  deletedAt                    DateTime?
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt

  gigPostings             GigPosting[]
  applications            Application[]
  engagementsAsWorker     Engagement[]                  @relation("EngagementWorker")
  engagementsAsEmployer   Engagement[]                  @relation("EngagementEmployer")
  engagementsCancelled    Engagement[]                  @relation("EngagementCancelledBy")
  engagementsEnded        Engagement[]                  @relation("EngagementEndedBy")
  cancellationRequests    CancellationRequest[]
  ratingsGiven            Rating[]                      @relation("RatingRater")
  ratingsReceived         Rating[]                      @relation("RatingRatee")
  completionRecords       CompletionRecord[]
  endorsementsGiven       Endorsement[]                 @relation("EndorsementEndorser")
  endorsementsReceived    Endorsement[]                 @relation("EndorsementWorker")
  reportsFiled            Report[]                      @relation("ReportReporter")
  reportsAgainst          Report[]                      @relation("ReportTargetUser")
  disputesRaised          DisputeCase[]                 @relation("DisputeRaisedBy")
  disputesResponded       DisputeCase[]                 @relation("DisputeRespondent")
  disputeEvidence         DisputeEvidence[]
  clarificationsAsked     DisputeClarificationRequest[]
  warnings                Warning[]
  savedGigs               SavedGig[]
  notifications           Notification[]
  otpCodes                OtpCode[]
  emailTokens             EmailVerificationToken[]
  ratingRemovalRequests   RatingRemovalRequest[]
  accountRecoveryRequests AccountRecoveryRequest[]

  @@index([accountStatus])
  @@index([deletedAt])
}

model OtpCode {
  id             String     @id @default(uuid())
  phone          String
  userId         String?
  adminAccountId String?
  code           String     @db.VarChar(6)
  purpose        OtpPurpose
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime   @default(now())

  user         User?         @relation(fields: [userId], references: [id])
  adminAccount AdminAccount? @relation(fields: [adminAccountId], references: [id])

  @@index([phone])
  @@index([userId])
}

model EmailVerificationToken {
  id         String            @id @default(uuid())
  userId     String
  email      String
  token      String            @unique
  purpose    EmailTokenPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime          @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AdminAccount {
  id                       String    @id @default(uuid())
  phone                    String    @unique
  // NULLABLE since 2026-09-20 (O5/A34). A promoted account has no password until its holder sets one
  // at first sign-in — FR-ADM-06's amendment makes that login OTP-only, so "no password yet" is a
  // real state and a placeholder hash would be a lie. FR-ADM-06's admin-assisted reset returns an
  // account to that state: nulling the hash is what stops the current password working immediately.
  // The login path must reject null explicitly rather than let bcrypt compare against it.
  passwordHash             String?
  failedLoginAttempts      Int       @default(0)
  lockedUntil              DateTime?
  // Batch A33 (2026-08-27). Staff sessions terminable on the same `iat` rule as User, re-checked
  // per dashboard request. `deactivatedAt` is set through the decisions.md runbook — no UI flow
  // exists for it, deliberately, and dashboard auth rejects on the next request.
  passwordChangedAt        DateTime?
  deactivatedAt            DateTime?
  // O6 (2026-09-20). The staff surface's Status column is DERIVED, not stored — it is the sign-in
  // state of the account, separate from its role. Its four values resolve as:
  // deactivatedAt set -> "Access removed" · lastSignInAt null -> "First sign-in pending" ·
  // long gap -> "Inactive — N days" · otherwise "Active". Nothing else in the schema records when a
  // staff account last signed in, and the audit log cannot stand in: it records actions on things,
  // not sessions, so it would conflate "has not signed in" with "has not done anything".
  lastSignInAt             DateTime?
  role                     AdminRole
  promotedByAdminAccountId String?
  createdAt                DateTime  @default(now())

  promotedBy AdminAccount?  @relation("AdminPromotion", fields: [promotedByAdminAccountId], references: [id])
  promoted   AdminAccount[] @relation("AdminPromotion")

  otpCodes           OtpCode[]
  ratingsRemoved     Rating[]
  disputesModerated  DisputeCase[]                 @relation("DisputeModerator")
  disputesRuled      DisputeCase[]                 @relation("DisputeAdmin")
  clarificationsMade DisputeClarificationRequest[]
  warningsIssued     Warning[]
  auditLog           AuditLogEntry[]
  notifications      Notification[]
  recoveriesReviewed AccountRecoveryRequest[]
}

// E8 (signed off 2026-09-16). FR-ACC-10 says that with neither phone nor verified email reachable
// "no automated path succeeds" — which was a dead end, not a policy: the account holds ratings,
// completion history and endorsements, which are the product's entire value to a job-seeker. This is
// the identity-verified, Admin-assisted route back.
//
// NOT a Report and NOT a DisputeCase. FR-ACC-10's amendment reserves this review to an Admin, never a
// Moderator, and NFR-OPS-01 already denies Moderators the audit log entirely.
//
// THERE IS NO NOTIFICATION, and that is a finding rather than an omission. FR-ACC-10 requires the
// outcome to reach the requesting device and no other channel. A Notification needs a userId, and
// the requester is unauthenticated by definition; both transports
// are unreachable by the definition of this path; and a push would confirm to whoever filled in the
// form that such an account exists — the enumeration leak FR-ACC-10 says must not happen.
model AccountRecoveryRequest {
  id                       String                @id @default(uuid())
  // The account the submitted details resolve to. NULLABLE deliberately: a submission matching no
  // account is still a submission, and saying so to the requester is the leak named above.
  userId                   String?
  // WHAT WAS SUBMITTED, retained rather than reduced to a verdict — the Admin adjudicates
  // the claim, and the case that matters in practice is the PARTIAL match, which one flag cannot
  // express. NIC uses the same deterministic scheme as User.nicEncrypted (account/nicCrypto.js);
  // that determinism is what makes the match possible. Retention is bounded by the requirement.
  nicSubmittedEncrypted    String
  legalNameSubmitted       String                @db.VarChar(100)
  birthdateSubmitted       DateTime              @db.Date
  // THE DEVICE BINDING. An install-scoped identifier the app generates on first run — not a hardware
  // id, needing no permission. Without it an approved recovery is a bearer grant: anyone reaching the
  // screen could set the password. This is the security mechanism of the flow.
  deviceId                 String
  status                   AccountRecoveryStatus @default(AWAITING_REVIEW)
  createdAt                DateTime              @default(now())
  reviewedByAdminAccountId String?
  reviewedAt               DateTime?
  // The approved grant, consumed once, when the requester sets a new password.
  completedAt              DateTime?

  user       User?         @relation(fields: [userId], references: [id])
  reviewedBy AdminAccount? @relation(fields: [reviewedByAdminAccountId], references: [id])

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// 2. Gig Posting & Discovery
// ---------------------------------------------------------------------------

model GigPosting {
  id                     String          @id @default(uuid())
  employerId             String
  title                  String          @db.VarChar(80)
  description            String          @db.VarChar(1000)
  category               GigCategory
  arrangementType        ArrangementType
  payKind                PayKind
  payAmount              Decimal?        @db.Decimal(12, 2)
  payRateUnit            PayRateUnit?
  postedAsType           PostingAsType
  postedBusinessName     String?         @db.VarChar(100)
  postedBusinessBio      String?         @db.VarChar(300)
  locationAddress        String
  locationLat            Float
  locationLng            Float
  locationAreaLabel      String
  workersNeeded          Int             @default(1)
  filledCount            Int             @default(0)
  startAt                DateTime
  schedule               String?         @db.VarChar(200)
  isUrgent               Boolean         @default(false)
  status                 GigStatus       @default(OPEN)
  noApplicantNudgeSentAt DateTime?
  autoHiddenAt           DateTime?
  withdrawnAt            DateTime?
  expiresAt              DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  employer               User                    @relation(fields: [employerId], references: [id])
  applications           Application[]
  engagements            Engagement[]
  savedBy                SavedGig[]
  materialChangeRequests MaterialChangeRequest[]
  reports                Report[]                @relation("ReportTargetGigPosting")

  @@index([status, category, arrangementType])
  @@index([locationLat, locationLng])
  @@index([startAt])
  @@index([employerId])
}

model SavedGig {
  id           String   @id @default(uuid())
  userId       String
  gigPostingId String
  savedAt      DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  gigPosting GigPosting @relation(fields: [gigPostingId], references: [id])

  @@unique([userId, gigPostingId])
}

model MaterialChangeRequest {
  id            String               @id @default(uuid())
  gigPostingId  String
  engagementId  String
  changeSummary Json
  proposedAt    DateTime             @default(now())
  deadline      DateTime
  status        MaterialChangeStatus @default(PENDING)
  respondedAt   DateTime?

  gigPosting GigPosting @relation(fields: [gigPostingId], references: [id])
  engagement Engagement @relation(fields: [engagementId], references: [id])

  @@index([engagementId])
}

// ---------------------------------------------------------------------------
// 3. Application & Engagement
// ---------------------------------------------------------------------------

model Application {
  id           String            @id @default(uuid())
  gigPostingId String
  workerId     String
  note         String?           @db.VarChar(300)
  status       ApplicationStatus @default(PENDING)
  appliedAt    DateTime          @default(now())
  decidedAt    DateTime?
  withdrawnAt  DateTime?

  gigPosting GigPosting  @relation(fields: [gigPostingId], references: [id])
  worker     User        @relation(fields: [workerId], references: [id])
  engagement Engagement?

  @@index([gigPostingId, status])
  @@index([workerId])
}

model Engagement {
  id                       String              @id @default(uuid())
  applicationId            String              @unique
  gigPostingId             String
  workerId                 String
  employerId               String
  status                   EngagementStatus    @default(ACTIVE)
  contactRevealedAt        DateTime            @default(now())
  arrivalCode              String?             @db.VarChar(6)
  arrivalStatus            CheckpointStatus    @default(PENDING)
  arrivalConfirmedAt       DateTime?
  completionCode           String?             @db.VarChar(6)
  completionStatus         CheckpointStatus    @default(PENDING)
  completionConfirmedAt    DateTime?
  paymentCode              String?             @db.VarChar(6)
  paymentStatus            CheckpointStatus?
  paymentConfirmedAt       DateTime?
  // Batch A17 (2026-08-27), decision D3: wrong checkpoint-code entries are RECORDED, never
  // rate-limited. A worker mistyping at arrival must not brick the checkpoint at the kerb, so
  // there is no lockout; the counters make repeated guessing visible evidence instead, rendered
  // in FR-MOD-01's code-exchange history where Moderators already look (FR-ENG-01).
  arrivalFailedAttempts    Int                 @default(0)
  completionFailedAttempts Int                 @default(0)
  paymentFailedAttempts    Int                 @default(0)
  startedAt                DateTime?
  ratingOpenedAt           DateTime?
  ratingEnforced           Boolean             @default(true)
  cancelledAt              DateTime?
  cancelledByUserId        String?
  cancellationReason       CancellationReason?
  isLateCancellation       Boolean?
  endedAt                  DateTime?
  endedByUserId            String?
  endIssueFlag             Boolean?
  stalledPromptSentAt      DateTime?
  stalledFlaggedAt         DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  application            Application             @relation(fields: [applicationId], references: [id])
  gigPosting             GigPosting              @relation(fields: [gigPostingId], references: [id])
  worker                 User                    @relation("EngagementWorker", fields: [workerId], references: [id])
  employer               User                    @relation("EngagementEmployer", fields: [employerId], references: [id])
  cancelledBy            User?                   @relation("EngagementCancelledBy", fields: [cancelledByUserId], references: [id])
  endedBy                User?                   @relation("EngagementEndedBy", fields: [endedByUserId], references: [id])
  materialChangeRequests MaterialChangeRequest[]
  cancellationRequests   CancellationRequest[]
  ratings                Rating[]
  completionRecords      CompletionRecord[]
  disputeCases           DisputeCase[]
  reports                Report[]                @relation("ReportTargetEngagement")

  @@index([workerId, status])
  @@index([employerId, status])
  @@index([gigPostingId])
}

model CancellationRequest {
  id                 String                    @id @default(uuid())
  engagementId       String
  requestedByUserId  String
  reason             CancellationReason
  isUrgentEngagement Boolean
  deadline           DateTime?
  status             CancellationRequestStatus @default(PENDING)
  requestedAt        DateTime                  @default(now())
  respondedAt        DateTime?

  engagement  Engagement @relation(fields: [engagementId], references: [id])
  requestedBy User       @relation(fields: [requestedByUserId], references: [id])

  @@index([engagementId])
}

// ---------------------------------------------------------------------------
// 4. Ratings & Reputation
// ---------------------------------------------------------------------------

model Rating {
  id                      String    @id @default(uuid())
  engagementId            String
  raterId                 String
  rateeId                 String
  score                   Int
  submittedAt             DateTime  @default(now())
  revealedAt              DateTime?
  // Batch A20: the only user-authored text field with no cap. 300 matches bio and note.
  publicResponse          String?   @db.VarChar(300)
  removedAt               DateTime?
  removedByAdminAccountId String?
  removalReason           String?   @db.VarChar(300)

  engagement     Engagement            @relation(fields: [engagementId], references: [id])
  rater          User                  @relation("RatingRater", fields: [raterId], references: [id])
  ratee          User                  @relation("RatingRatee", fields: [rateeId], references: [id])
  removedBy      AdminAccount?         @relation(fields: [removedByAdminAccountId], references: [id])
  removalRequest RatingRemovalRequest?

  @@unique([engagementId, raterId])
  @@index([rateeId, revealedAt])
}

// Batch A21 (2026-08-27), decision D8. `Rating` already carries the RULING — removedAt,
// removedByAdminAccountId, removalReason — but nothing carried the REQUEST. `Report` cannot
// target a Rating, and reusing it would be wrong even if it could: FR-RATE-06 is explicit that a
// rating-fairness path never enters the Moderator triage queue and reaches Admin directly.
//
// `ratingId` is unique because docs/database-schema.md's ER diagram declares this relationship
// `Rating ||--o| RatingRemovalRequest`, and both other `||--o|` relations in this schema
// (Application->Engagement, Report->DisputeCase) are enforced with a unique FK. One request per
// rating, ever — a ruled request is not re-openable. See the drafting note for the consequence.
model RatingRemovalRequest {
  id                String    @id @default(uuid())
  ratingId          String    @unique
  requestedByUserId String
  grounds           String    @db.VarChar(300)
  createdAt         DateTime  @default(now())
  ruledAt           DateTime?

  rating      Rating @relation(fields: [ratingId], references: [id])
  requestedBy User   @relation(fields: [requestedByUserId], references: [id])
}

model CompletionRecord {
  id           String            @id @default(uuid())
  userId       String
  engagementId String
  outcome      CompletionOutcome
  weight       Decimal           @default(1.0) @db.Decimal(4, 2)
  recordedAt   DateTime          @default(now())

  user       User       @relation(fields: [userId], references: [id])
  engagement Engagement @relation(fields: [engagementId], references: [id])

  @@index([userId])
}

// ---------------------------------------------------------------------------
// 5. Community Endorsement
// ---------------------------------------------------------------------------

model Endorsement {
  id         String                 @id @default(uuid())
  endorserId String
  workerId   String
  reason     String?                @db.VarChar(300)
  // Optional, multi-select. What the endorser can specifically attest to
  // (FR-ENDORSE-04, amended 2026-08-27). An empty array is valid and must stay
  // valid — the requirement's single-action principle means a Verifier can vouch
  // without selecting anything. Only selected values may ever be displayed:
  // rendering the unselected ones would turn an optional field into a negative
  // signal about the worker. See docs/database-schema.md under `Endorsement`.
  attributes EndorsementAttribute[] @default([])
  entryPoint EndorsementEntryPoint
  createdAt  DateTime               @default(now())
  revokedAt  DateTime?

  endorser User @relation("EndorsementEndorser", fields: [endorserId], references: [id])
  worker   User @relation("EndorsementWorker", fields: [workerId], references: [id])

  // One ACTIVE endorsement per endorser per worker (FR-ENDORSE-08 as amended
  // 2026-09-24): a partial unique index on (endorserId, workerId) where revokedAt
  // is null, raw SQL in 20260925001500_prototype_spec_batch. Not @@unique — a
  // revoked endorsement may be replaced while the worker is still eligible.
  @@index([workerId, revokedAt])
  @@index([endorserId, revokedAt])
}

// ---------------------------------------------------------------------------
// 6. Disputes & Moderation
// ---------------------------------------------------------------------------

model Report {
  id                 String       @id @default(uuid())
  reporterId         String
  targetUserId       String?
  targetGigPostingId String?
  targetEngagementId String?
  reason             ReportReason
  detail             String?      @db.VarChar(1000)
  status             ReportStatus @default(QUEUED)
  createdAt          DateTime     @default(now())

  reporter         User         @relation("ReportReporter", fields: [reporterId], references: [id])
  targetUser       User?        @relation("ReportTargetUser", fields: [targetUserId], references: [id])
  targetGigPosting GigPosting?  @relation("ReportTargetGigPosting", fields: [targetGigPostingId], references: [id])
  targetEngagement Engagement?  @relation("ReportTargetEngagement", fields: [targetEngagementId], references: [id])
  disputeCase      DisputeCase?

  @@index([targetUserId])
  @@index([targetGigPostingId])
}

model DisputeCase {
  id                 String             @id @default(uuid())
  engagementId       String?
  reportId           String?            @unique
  triggerType        DisputeTriggerType
  raisedByUserId     String?
  respondentUserId   String?
  respondentDeadline DateTime?
  status             DisputeStatus      @default(AWAITING_RESPONSE)
  moderatorAccountId String?
  adminAccountId     String?
  resolution         DisputeResolution?
  resolutionNotes    String?            @db.VarChar(1000)
  resolvedAt         DateTime?
  createdAt          DateTime           @default(now())

  engagement Engagement?   @relation(fields: [engagementId], references: [id])
  report     Report?       @relation(fields: [reportId], references: [id])
  raisedBy   User?         @relation("DisputeRaisedBy", fields: [raisedByUserId], references: [id])
  respondent User?         @relation("DisputeRespondent", fields: [respondentUserId], references: [id])
  moderator  AdminAccount? @relation("DisputeModerator", fields: [moderatorAccountId], references: [id])
  admin      AdminAccount? @relation("DisputeAdmin", fields: [adminAccountId], references: [id])

  evidence       DisputeEvidence[]
  clarifications DisputeClarificationRequest[]
  warnings       Warning[]

  @@index([status])
  @@index([engagementId])
}

model DisputeEvidence {
  id                String   @id @default(uuid())
  disputeCaseId     String
  submittedByUserId String
  imageUrl          String
  uploadedAt        DateTime @default(now())

  disputeCase DisputeCase @relation(fields: [disputeCaseId], references: [id])
  submittedBy User        @relation(fields: [submittedByUserId], references: [id])

  @@index([disputeCaseId])
}

model DisputeClarificationRequest {
  id                        String    @id @default(uuid())
  disputeCaseId             String
  requestedByAdminAccountId String
  requestedFromUserId       String
  question                  String    @db.VarChar(300)
  deadline                  DateTime
  response                  String?   @db.VarChar(1000)
  respondedAt               DateTime?
  createdAt                 DateTime  @default(now())

  disputeCase   DisputeCase  @relation(fields: [disputeCaseId], references: [id])
  requestedBy   AdminAccount @relation(fields: [requestedByAdminAccountId], references: [id])
  requestedFrom User         @relation(fields: [requestedFromUserId], references: [id])

  @@index([disputeCaseId])
}

model Warning {
  id                     String   @id @default(uuid())
  userId                 String
  disputeCaseId          String?
  issuedByAdminAccountId String
  reason                 String   @db.VarChar(300)
  issuedAt               DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id])
  disputeCase DisputeCase? @relation(fields: [disputeCaseId], references: [id])
  issuedBy    AdminAccount @relation(fields: [issuedByAdminAccountId], references: [id])

  @@index([userId, issuedAt])
}

// ---------------------------------------------------------------------------
// 7. Admin Operations
// ---------------------------------------------------------------------------

model AuditLogEntry {
  id             String          @id @default(uuid())
  adminAccountId String
  // Batch A29 (2026-08-27), decision D7. Free strings meant every developer would invent their
  // own verbs for the same act, and an audit log whose vocabulary drifts cannot be filtered or
  // counted. One value per acting surface in Module 10 (FR-ADM-06, NFR-SEC-05).
  action         AuditAction
  targetType     AuditTargetType
  targetId       String?
  details        Json?
  createdAt      DateTime        @default(now())

  adminAccount AdminAccount @relation(fields: [adminAccountId], references: [id])

  @@index([adminAccountId, createdAt])
}

// ---------------------------------------------------------------------------
// 8. Notifications
// ---------------------------------------------------------------------------

model Notification {
  id              String           @id @default(uuid())
  userId          String?
  adminAccountId  String?
  type            NotificationType
  payload         Json
  createdAt       DateTime         @default(now())
  readAt          DateTime?
  pushSentAt      DateTime?
  batchedDigestId String?

  user          User?          @relation(fields: [userId], references: [id])
  adminAccount  AdminAccount?  @relation(fields: [adminAccountId], references: [id])
  batchedDigest Notification?  @relation("NotificationDigest", fields: [batchedDigestId], references: [id])
  batchedItems  Notification[] @relation("NotificationDigest")

  @@index([userId, readAt])
  @@index([adminAccountId, readAt])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ActorRole {
  YOUTH_JOB_SEEKER
  EMPLOYER
  COMMUNITY_ENDORSER
}

enum PostingAsType {
  INDIVIDUAL
  BUSINESS
}

enum AccountStatus {
  PENDING_SIGNUP
  ACTIVE
  SUSPENDED
  DELETED
}

enum AdminRole {
  ADMIN
  MODERATOR
}

// A queued request awaits Admin review, and the review offers exactly two actions, approve and reject.
// Three values and no more — there is no Moderator stage for this to be under review for. The
// worker-facing app presents only the approved outcome; REJECTED still has to exist in data, and is
// a recorded scope decision rather than an omission.
enum AccountRecoveryStatus {
  AWAITING_REVIEW
  APPROVED
  REJECTED
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  PASSWORD_RESET
  PHONE_CHANGE
  ADMIN_LOGIN
}

enum EmailTokenPurpose {
  SIGNUP
  EMAIL_CHANGE
  PASSWORD_RESET
}

enum GigCategory {
  RETAIL
  DELIVERY
  EVENT_SETUP
  MOVING
  FOOD_SERVICE
  TUTORING
  CLEANING
}

enum ArrangementType {
  GIG
  PART_TIME
  INTERNSHIP
}

enum PayKind {
  FIXED_TOTAL
  RATE
  UNPAID
  STIPEND
  PAID
}

enum PayRateUnit {
  DAY
  WEEK
  MONTH
}

enum GigStatus {
  OPEN
  FILLED
  WITHDRAWN
  EXPIRED
}

enum MaterialChangeStatus {
  PENDING
  ACCEPTED
  DECLINED_ROUTED_TO_CANCELLATION
}

enum CancellationRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  AUTO_RESOLVED_NO_RESPONSE
  IMMEDIATE
}

enum ApplicationStatus {
  PENDING
  SELECTED
  DECLINED
  WITHDRAWN
  NOT_SELECTED
}

enum EngagementStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  ENDED
  DISPUTED
}

enum CheckpointStatus {
  PENDING
  CONFIRMED
  UNABLE_TO_CONFIRM
