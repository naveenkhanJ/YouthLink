// Batch A29 (2026-08-27), decision D7 — CORRECTED 2026-09-20 against the screen it exists for.
// Free strings meant every developer would invent their own verb for the same act, and an audit log
// whose vocabulary drifts cannot be filtered or counted. But a CLOSED enum is only safe when it is
// closed over the vocabulary that actually exists, and D7's ten values were derived from "one per
// Module 10 acting surface". The audit log is a MODULE 11 surface that also receives staff
// administration and metrics actions, and D7 covered seven of the fourteen the dashboard performs.
// The six marked below were missing outright, and CASE_WARNING_CLOSED was renamed — recording a
// warning against a USER and closing a case against a REPORT are two acts, not one.
enum AuditAction {
  // Case handling (Module 10)
  CASE_REVIEW_OPENED // + 2026-09-20 · "Opened case review"
  CLARIFICATION_REQUESTED
  WARNING_RECORDED // renamed from CASE_WARNING_CLOSED, 2026-09-20
  CASE_CLOSED_NO_ACTION // + 2026-09-20 · "Closed case — no action"
  CASE_ESCALATED
  DISPUTE_RULED
  // Content and accounts
  CONTENT_RESTORED
  CONTENT_ESCALATED
  POSTING_REMOVED
  RATING_REMOVED
  ACCOUNT_SUSPENDED
  // Staff administration (Module 11) — USER_PROMOTED is FR-ADM-06; the two below are its 2026-09-20
  // amendment (openings O5/O6), and both are logged like every other privileged action.
  USER_PROMOTED
  STAFF_PASSWORD_RESET // + 2026-09-20 · "Reset staff password"
  STAFF_ACCESS_REMOVED // + 2026-09-20 · "Removed staff access"
  // Platform
  METRICS_EXPORTED // + 2026-09-20 · metrics export (FR-DASH-04, NFR-OPS-02)
  ACCOUNT_RECOVERY_APPROVED // + 2026-09-20 · account recovery approved (FR-ACC-10)
  ACCOUNT_RECOVERY_REJECTED // + 2026-09-20 · an unlogged staff refusal on
  //   someone's account is precisely what NFR-SEC-06 forbids
}

