# Copy this file to mobile/.env and set your own value.
# mobile/.env is git-ignored. EXPO_PUBLIC_* values end up inside the app bundle,
# so nothing secret ever goes here.

# Where the backend runs, as seen from the phone or emulator.
#   Android emulator:  http://10.0.2.2:3000
#   Physical phone:    http://<your computer's LAN IP>:3000  (same Wi-Fi network)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Only for `npm run build:release-apk` (an APK you install on a phone): the public address
# of the backend, e.g. your ngrok static domain. Not read by `expo start`, so the emulator
# keeps using EXPO_PUBLIC_API_URL above. Leave it out and pass --api-url instead if you prefer.
# RELEASE_API_URL=https://<your-name>.ngrok-free.dev
